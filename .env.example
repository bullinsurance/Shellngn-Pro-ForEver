# ---------------------------------------------------------------------------
# Shellngn Pro - variables de entorno
# Copia este archivo a ".env" y ajusta los valores según tu despliegue.
# ---------------------------------------------------------------------------

# Puerto publicado en el HOST (el contenedor siempre escucha en PORT internamente)
APP_PORT=8080

# Puerto interno de escucha dentro del contenedor
PORT=8080

# Host de escucha dentro del contenedor
HOST=0.0.0.0

# Cross-Origin Resource Sharing. "*" permite cualquier origen.
CORS=*

# Prefijo de URL, útil si sirves la app detrás de un reverse proxy en un subpath
# Ej: BASE_URL=/shellngn
BASE_URL=/

# Nivel de logs: error | warn | info | http | debug
LOG_LEVEL=info

# Logging a archivo con rotación diaria (true/false)
LOG_TO_FILE=false

# Directorio de logs dentro del contenedor (solo aplica si LOG_TO_FILE=true)
LOG_DIR=./logs

# --- Opcionales (dejar vacíos si no se usan) ---

# Certificado/llave TLS: nombre de archivo dentro de ./data/tls
# Solo necesario si sirves HTTPS directamente desde el contenedor
# (no recomendado; usa un reverse proxy en su lugar, ver README)
TLS_CERT=
TLS_KEY=

# Resetear la contraseña de un usuario al iniciar el contenedor.
# Formato: usuario:nueva_contraseña
# Ej: RESET_USER=admin:MiPasswordSegura123
# IMPORTANTE: quitar esta variable después de usarla una vez.
RESET_USER=

# --- Panel (contenedor aparte, ver README sección "Panel web") ---

# Path ABSOLUTO de este repo en el HOST. El contenedor del panel monta el
# repo (y su directorio padre) en este mismo path adentro, para poder
# ejecutar "docker compose" contra el socket del host con las rutas
# relativas del docker-compose.yml resueltas correctamente.
PROJECT_DIR=/ruta/absoluta/a/este/repo

# Directorio padre del repo en el HOST (path ABSOLUTO). Se monta también
# para que "Desplegar copia" (clon en otro puerto) pueda crear
# ../shellngn-<nombre> como hace hoy corriendo el panel directo en el host.
HOST_APPS_DIR=/ruta/absoluta/al/padre
